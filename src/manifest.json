{
    "manifest_version": 3,
    "name": "scribbledown",
    "version": "0.0.1",
    "background": {
        "scripts": ["background_script.js"]
    },
    "content_scripts": [
        {
            "matches": ["*://www.scribblehub.com/series/*"],
            "js": ["content_script.js"],
            "css": ["content_script.css"]
        }
    ],
    "browser_specific_settings": {
        "gecko": {
            "id": "scribbledown@ariagivens.com",
            "strict_min_version": "142.0",
            "data_collection_permissions": {
                "required": ["none"]
            }
        }
    },
    "host_permissions": [
        "*://cdn.scribblehub.com/images/*",
        "*://www.scribblehub.com/img/*"
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "fonts/AtkinsonHyperlegible-Regular.ttf",
                "fonts/AtkinsonHyperlegible-Italic.ttf",
                "fonts/AtkinsonHyperlegible-Bold.ttf",
                "fonts/AtkinsonHyperlegible-BoldItalic.ttf"
            ],
            "matches": ["*://www.scribblehub.com/series/*"]
        }
    ]
}
