{
    "manifest_version": 2,
    "name": "scribbledown",
    "version": "0.0.1",
    "content_scripts": [
        {
            "matches": ["*://*.scribblehub.com/*"],
            "js": ["content_script.js"]
        }
    ],
    "browser_specific_settings": {
        "gecko": {
            "id": "scribbledown@ariagivens.com",
            "strict_min_version": "142.0",
            "data_collection_permissions": {
                "required": ["none"]
            }
        }
    }
}
