<?xml version="1.0" encoding="UTF-8" ?>
<package
    xmlns="http://www.idpf.org/2007/opf"
    unique-identifier="uid"
    version="3.0"
>
    <metadata xmlns:dc="http://purl.org/dc/elements/1.1/">
        <dc:identifier id="uid">{{uid}}</dc:identifier>
        <dc:title id="title">{{title.title}}</dc:title>
        <meta property="title-type" refines="#title">main</meta>
        {{#each title.subtitles}}
        <dc:title id="subtitle-{{@index}}">{{this}}</dc:title>
        <meta property="title-type" refines="#subtitle-{{@index}}">
            subtitle
        </meta>
        {{/each}}
        <dc:title id="fulltitle">{{fulltitle}}</dc:title>
        <meta property="title-type" refines="#fulltitle">extended</meta>
        <dc:creator>{{author.name}}</dc:creator>
        <dc:language>en</dc:language>
        <meta name="cover" content="cover-image" />
    </metadata>
    <manifest>
        <item
            href="cover.{{cover.extension}}"
            id="cover-image"
            media-type="{{cover.content_type}}"
            properties="cover-image"
        />
        <item
            href="nav.xhtml"
            id="toc"
            media-type="application/xhtml+xml"
            properties="nav"
        />
        <item
            href="cover.xhtml"
            id="cover-page"
            media-type="application/xhtml+xml"
            properties="calibre:title-page"
        />
        <item
            href="title.xhtml"
            id="title-page"
            media-type="application/xhtml+xml"
        />
        {{#each chapters}}
        <item
            href="{{identifier}}.xhtml"
            id="{{identifier}}"
            media-type="application/xhtml+xml"
        />
        {{/each}}
        <item href="fonts.css" id="font-embed" media-type="text/css" />
        {{#each fonts}}
        <item href="{{src}}" id="{{identifier}}" media-type="font/ttf" />
        {{/each}}
        <item href="style.css" id="style" media-type="text/css" />
    </manifest>
    <spine>
        <itemref idref="cover-page" />
        <itemref idref="title-page" />
        {{#each chapters}}
        <itemref idref="{{identifier}}" />
        {{/each}}
    </spine>
</package>
