@page {
    margin-bottom: 5pt;
    margin-top: 5pt;
}

p {
    display: block;
    font-family: "{{font_family}}", serif;
    font-style: normal;
    font-weight: normal;
    font-size: 1rem;
    line-height: 1.2;
    text-align: left;
    text-indent: 1em;
    margin: 0;
    padding: 0;
}

hr.whitespace-break {
    border: none;
    height: 0;
    margin: 2lh 0 0 0;
}

hr.dinkus-break {
    border: none;
    height: 1lh;
    margin-top: 1lh;
    margin-bottom: 0;
}

span.dinkus-break {
    position: relative;
    top: -1lh;
    display: block;
    text-align: center;
	-webkit-user-select: none;
    user-select: none;
}
