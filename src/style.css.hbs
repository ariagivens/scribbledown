@page {
    margin-bottom: 5pt;
    margin-top: 5pt;
}

p {
    display: block;
    font-family: "{{font_family}}", serif;
    font-style: normal;
    font-weight: normal;
    font-size: 1rem;
    line-height: 1.2;
    text-align: left;
    margin: 0;
    padding: 0;
}

p + p {
    text-indent: 1em;
}

hr.whitespace-break {
    border: none;
    height: 0;
    margin: 2lh 0 0 0;
}

span.dinkus-break {
    display: block;
    border: none;
    height: 1lh;
    margin-top: 1lh;
    margin-bottom: 1lh;
    text-align: center;
    -webkit-user-select: none;
    user-select: none;
}

.cover {
    width: 100vw;
    height: 100vh;
}

.cover img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
}

nav.landmarks {
    display: none;
}
