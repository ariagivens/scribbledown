<html xmlns="http://www.w3.org/1999/xhtml">
    <head>
        <meta charset="UTF-8" />
        <title>{{title}}</title>
    </head>
    <body>
        {{#each chapters}}
            <section>
                <h2 id="c.{{order}}">{{title}}</h2>
                {{#each paragraphs}}
                    <p>{{this}}</p>
                {{/each}}
            </section>
        {{/each}}
    </body>
</html>